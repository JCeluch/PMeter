    "education.npr-methods.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural family planning methods use observable signs of fertility to identify fertile and infertile days. Each method has its own rules, signs, and learning curve."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metody naturalnego planowania rodziny wykorzystują obserwowalne znaki płodności do identyfikacji dni płodnych i niepłodnych. Każda metoda ma swoje reguły, znaki i krzywe uczenia się."
          }
        }
      }
    },
    "education.npr-methods.method.billings.body1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developed by Drs John and Evelyn Billings in Australia, the Billings Ovulation Method (BOM) is based solely on the observation of cervical mucus — specifically, the sensation it creates at the vulvar opening (external observation only, no internal checking)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opracowana przez dr Jana i Evelyn Billings w Australii, Metoda Owulacji Billingsów (MOB) opiera się wyłącznie na obserwacji śluzu szyjkowego — konkretnie na odczuciu jakie tworzy przy wejściu do pochwy (tylko obserwacja zewnętrzna, bez wewnętrznej)."
          }
        }
      }
    },
    "education.npr-methods.method.billings.body2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key concept is the \"Basic Infertile Pattern\" (BIP) — the normal, unchanging mucus pattern a woman sees during her infertile phases. Any change from the BIP signals the beginning of the potentially fertile phase. The method requires no thermometer and can be used in various circumstances including breastfeeding and perimenopause."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluczowym pojęciem jest \"Podstawowy Wzorzec Niepłodności\" (PWN) — normalny, niezmieniający się wzorzec śluzu, który kobieta widzi w fazach niepłodnych. Każda zmiana od PWN sygnalizuje początek potencjalnie płodnej fazy. Metoda nie wymaga termometru i może być stosowana w różnych okolicznościach, w tym podczas karmienia piersią i perimenopauzy."
          }
        }
      }
    },
    "education.npr-methods.method.billings.certification" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taught by certified Billings instructors through the World Organisation of Ovulation Method Billings (WOOMB)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauczana przez certyfikowanych instruktorów Billingsów przez Światową Organizację Metody Owulacji Billingsów (WOOMB)."
          }
        }
      }
    },
    "education.npr-methods.method.billings.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billings Ovulation Method"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Owulacji Billingsów"
          }
        }
      }
    },
    "education.npr-methods.method.billings.rule1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any day of dryness (Basic Infertile Pattern) before ovulation is potentially infertile"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy suchy dzień (Podstawowy Wzorzec Niepłodności) przed owulacją jest potencjalnie niepłodny"
          }
        }
      }
    },
    "education.npr-methods.method.billings.rule2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any change from the BIP — wetter, slippery, or different — signals potential fertility"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda zmiana od PWN — bardziej mokro, ślisko lub inaczej — sygnalizuje potencjalną płodność"
          }
        }
      }
    },
    "education.npr-methods.method.billings.rule3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Peak Day is the last day of the most fertile type of mucus, identified retrospectively"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień Szczytowy to ostatni dzień najbardziej płodnego typu śluzu, identyfikowany retrospektywnie"
          }
        }
      }
    },
    "education.npr-methods.method.billings.rule4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post-ovulatory infertile phase begins the evening of the 4th day after Peak Day"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pofertylna faza niepłodna zaczyna się wieczorem 4. dnia po Dniu Szczytowym"
          }
        }
      }
    },
    "education.npr-methods.method.billings.sign1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical mucus — sensation at the vulvar opening, observed throughout the day (external observation only)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy — odczucie przy wardze sromowej, obserwowane przez cały dzień (tylko obserwacja zewnętrzna)"
          }
        }
      }
    },
    "education.npr-methods.method.billings.signs-badge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucus only"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko śluz"
          }
        }
      }
    },
    "education.npr-methods.method.billings.suitable-for" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Women who cannot measure temperature (shift workers, frequent travellers), breastfeeding women, perimenopause. Requires good ability to notice external sensation throughout the day."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kobiety, które nie mogą mierzyć temperatury (pracownicy zmianowi, częste podróże), karmiące piersią, perimenopauza. Wymaga dobrej umiejętności zauważania zewnętrznego odczucia przez cały dzień."
          }
        }
      }
    },
    "education.npr-methods.method.billings.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucus-only method based on vulvar sensation throughout the day."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda oparta wyłącznie na śluzie — odczucie przy wardze sromowej przez cały dzień."
          }
        }
      }
    },
    "education.npr-methods.method.calendar.body1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calendar (rhythm) method estimates the fertile window by applying a formula to the lengths of the previous 6–12 menstrual cycles. The most common version (Ogino-Knaus formula) subtracts 18 from the shortest cycle to find the first fertile day, and 11 from the longest to find the last."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda kalendarzowa (rytmu) szacuje okno płodności stosując formułę do długości poprzednich 6–12 cykli miesiączkowych. Najczęstsza wersja (formuła Ogino-Knausa) odejmuje 18 od najkrótszego cyklu by znaleźć pierwszy płodny dzień, i 11 od najdłuższego by znaleźć ostatni."
          }
        }
      }
    },
    "education.npr-methods.method.calendar.body2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calendar method is not considered a reliable modern NFP method. It relies entirely on the assumption that future cycles will repeat past patterns — which is often false, especially after illness, stress, or life changes. P-Meter includes it for educational comparison only, not as a recommended approach."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda kalendarzowa nie jest uważana za wiarygodną nowoczesną metodę NPR. Opiera się wyłącznie na założeniu, że przyszłe cykle będą powtarzać przeszłe wzorce — co często jest błędne, szczególnie po chorobie, stresie lub zmianach życiowych. P-Meter zawiera ją wyłącznie do celów edukacyjnego porównania, nie jako zalecane podejście."
          }
        }
      }
    },
    "education.npr-methods.method.calendar.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar / Rhythm Method"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda kalendarzowa / rytmu"
          }
        }
      }
    },
    "education.npr-methods.method.calendar.rule1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First fertile day = shortest past cycle − 18"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy płodny dzień = najkrótszy przeszły cykl − 18"
          }
        }
      }
    },
    "education.npr-methods.method.calendar.rule2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last fertile day = longest past cycle − 11"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatni płodny dzień = najdłuższy przeszły cykl − 11"
          }
        }
      }
    },
    "education.npr-methods.method.calendar.sign1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycle length history — no daily observations required"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia długości cykli — nie są wymagane codzienne obserwacje"
          }
        }
      }
    },
    "education.npr-methods.method.calendar.signs-badge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar only"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko kalendarz"
          }
        }
      }
    },
    "education.npr-methods.method.calendar.suitable-for" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not recommended as a standalone method. Useful as a general orientation alongside a biomarker-based method. Highly unreliable for women with irregular cycles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezalecana jako samodzielna metoda. Przydatna jako ogólna orientacja obok metody opartej na biomarkerach. Wysoce zawodna dla kobiet z nieregularnymi cyklami."
          }
        }
      }
    },
    "education.npr-methods.method.calendar.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimates fertile days based on past cycle lengths only."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacuje dni płodne wyłącznie na podstawie długości poprzednich cykli."
          }
        }
      }
    },
    "education.npr-methods.method.creighton.body1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Creighton Model FertilityCare System (CrMS) was developed at the Pope Paul VI Institute by Dr Thomas Hilgers as a standardised, teachable system based on cervical mucus observation. It uses a precise visual classification of mucus with a standardised charting stamp system (categories: dry, VE, G, L, K, 10C, 10CK, 10KL, 10KP, 10W, etc.)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creighton Model FertilityCare System (CrMS) został opracowany w Instytucie Papieża Pawła VI przez dr Thomasa Hilgersa jako ustandaryzowany, nauczalny system oparty na obserwacji śluzu szyjkowego. Stosuje precyzyjną wizualną klasyfikację śluzu ze ustandaryzowanym systemem stemplowania kart (kategorie: sucho, VE, G, L, K, 10C, 10CK, 10KL, 10KP, 10W, itp.)."
          }
        }
      }
    },
    "education.npr-methods.method.creighton.body2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlike Billings, Creighton also records the physical appearance and characteristics of mucus collected on toilet paper (internal sensation is not the primary focus — the collected sample is). The standardised notation makes charting comparable across practitioners and supports medical diagnosis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przeciwieństwie do Billingsów, Creighton zapisuje również fizyczny wygląd i charakterystyki śluzu zebranego na papierze toaletowym (wewnętrzne odczucie nie jest głównym przedmiotem — jest nim zebrany próbka). Ustandaryzowana notacja sprawia, że prowadzenie karty jest porównywalne u różnych praktyków i wspiera diagnozę medyczną."
          }
        }
      }
    },
    "education.npr-methods.method.creighton.body3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrMS is also the foundation of NaProTechnology (Natural Procreative Technology), a medical approach used to diagnose and treat reproductive disorders using cycle chart data."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrMS jest również podstawą NaProTechnology (Naturalnej Technologii Prokreacyjnej), podejścia medycznego stosowanego do diagnozowania i leczenia zaburzeń reprodukcyjnych przy użyciu danych z kart cyklu."
          }
        }
      }
    },
    "education.npr-methods.method.creighton.certification" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taught exclusively by certified FertilityCare Practitioners. More info: creightonmodel.com"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauczana wyłącznie przez certyfikowanych Praktyków FertilityCare. Więcej: creightonmodel.com"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creighton Model FertilityCare™"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creighton Model FertilityCare™"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.rule1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any observation other than dry/nothing is potentially fertile and must be treated as such"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda obserwacja inna niż sucha/nic jest potencjalnie płodna i musi być traktowana jako taka"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.rule2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Peak Day rules follow Billings-based Post-Peak calculations (4-day rule)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły Dnia Szczytowego stosują obliczenia Post-Szczytowe oparte na Billingsach (zasada 4 dni)"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.rule3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires learning the full standardised stamp/classification system — self-teaching is not recommended"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga nauki pełnego ustandaryzowanego systemu stemplowania/klasyfikacji — samodzielna nauka nie jest zalecana"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.sign1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical mucus — physical appearance of collected sample + vulvar sensation (external observation, standardised classification)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy — fizyczny wygląd zebranej próbki + odczucie na wardze sromowej (obserwacja zewnętrzna, ustandaryzowana klasyfikacja)"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.signs-badge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucus only"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko śluz"
          }
        }
      }
    },
    "education.npr-methods.method.creighton.suitable-for" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Women who want detailed charting that can interface with medical diagnosis (NaPro). Requires working with a certified FertilityCare Practitioner (FCP)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kobiety które chcą szczegółowego prowadzenia kart mogącego współpracować z diagnozą medyczną (NaPro). Wymaga pracy z certyfikowanym Praktykiem FertilityCare (FCP)."
          }
        }
      }
    },
    "education.npr-methods.method.creighton.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardised mucus-only method with precise classification system."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustandaryzowana metoda śluzowa z precyzyjnym systemem klasyfikacji."
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.body1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developed by gynaecologist Josef Rötzer in Austria, the Rötzer method is a rigorous variant of STM that requires all three signs — temperature, mucus, and cervix — for fertility evaluation. It places particular emphasis on the cervix as a primary sign, not merely a supplement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opracowana przez ginekologa Josefa Rötzer w Austrii, metoda Rötzer jest rygorystycznym wariantem STM wymagającym wszystkich trzech znaków — temperatury, śluzu i szyjki — do oceny płodności. Szczególny nacisk kładzie na szyjkę jako znak podstawowy, nie tylko uzupełniający."
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.body2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The method uses a specific set of rules for identifying the fertile window that differs slightly from the Sensiplan variant. It is taught exclusively by certified NFP-Rötzer instructors and is particularly widespread in Austria, Germany, and among Catholic family planning organisations."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda stosuje specyficzny zestaw reguł do identyfikacji okna płodności, który różni się nieco od wariantu Sensiplan. Jest nauczana wyłącznie przez certyfikowanych instruktorów NFP-Rötzer i jest szczególnie rozpowszechniona w Austrii, Niemczech i wśród katolickich organizacji planowania rodziny."
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.certification" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taught exclusively by NFP-Rötzer certified instructors. More info: nfp-online.com"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauczana wyłącznie przez certyfikowanych instruktorów NFP-Rötzer. Więcej: nfp-online.com"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rötzer Method (NFP-Rötzer)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Rötzer (NFP-Rötzer)"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.rule1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All three signs must agree before the post-ovulatory infertile phase is declared"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie trzy znaki muszą być zgodne zanim zostanie ogłoszona pofertylna faza niepłodna"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.rule2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post-ovulatory phase confirmed on the evening of the 3rd consecutive elevated temperature with concurrent mucus drying and cervix closure"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza pofertylna potwierdzona wieczorem 3. kolejnego dnia podwyższonej temperatury z równoczesnym wysychaniem śluzu i zamknięciem szyjki"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.rule3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specific pre-ovulatory rules apply — consult a certified instructor"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obowiązują szczegółowe zasady przedowulacyjne — skonsultuj się z certyfikowanym instruktorem"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.sign1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal body temperature (BBT)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa temperatura ciała (PTC)"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.sign2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical mucus"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.sign3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervix — required, not optional"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szyjka macicy — wymagana, nie opcjonalna"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.signs-badge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temp + Mucus + Cervix"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temp + Śluz + Szyjka"
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.suitable-for" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Women comfortable with internal cervix observation and committed to learning all three signs. Particularly recommended for couples seeking maximum confidence in their observations."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kobiety komfortowo czujące się z wewnętrzną obserwacją szyjki i zaangażowane w naukę wszystkich trzech znaków. Szczególnie zalecana parom szukającym maksymalnej pewności w obserwacjach."
          }
        }
      }
    },
    "education.npr-methods.method.roetzer.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An advanced STM variant with strict triple-sign confirmation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaawansowany wariant STM ze ścisłym potwierdzeniem trzech znaków."
          }
        }
      }
    },
    "education.npr-methods.method.stm.body1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Sympto-Thermal Method (STM) is the most widely used form of fertility awareness in Europe. It combines at least two biological signs: basal body temperature (BBT) and cervical mucus observations, with optional cervix checking as a third corroborating sign."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Symptotermiczna (STM) jest najpowszechniej stosowaną formą świadomości płodności w Europie. Łączy co najmniej dwa znaki biologiczne: podstawową temperaturę ciała (PTC) i obserwację śluzu szyjkowego, z opcjonalną obserwacją szyjki jako trzecim znakiem potwierdzającym."
          }
        }
      }
    },
    "education.npr-methods.method.stm.body2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fertile window is identified by the mucus observations; its end is confirmed by the temperature shift (thermal shift) sustained for at least three consecutive days above the coverline. This double-check principle — mucus plus temperature — gives STM a high effectiveness rate of 99.6% with perfect use according to peer-reviewed studies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno płodne jest identyfikowane przez obserwacje śluzu; jego koniec potwierdzany jest przez skok termiczny utrzymujący się przez co najmniej trzy kolejne dni powyżej linii pokrycia. Ta zasada podwójnej kontroli — śluz plus temperatura — daje STM wysoką skuteczność 99,6% przy doskonałym stosowaniu według recenzowanych badań."
          }
        }
      }
    },
    "education.npr-methods.method.stm.body3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STM can be used to avoid or achieve pregnancy, and is also valuable for monitoring reproductive health. Many variants exist (Sensiplan, Rötzer, FEMM) — P-Meter is designed around the core principles common to most European STM curricula."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STM może być używana do unikania lub osiągnięcia ciąży, a także jest cenna do monitorowania zdrowia reprodukcyjnego. Istnieje wiele wariantów (Sensiplan, Rötzer, FEMM) — P-Meter jest zaprojektowana wokół podstawowych zasad wspólnych dla większości europejskich programów STM."
          }
        }
      }
    },
    "education.npr-methods.method.stm.certification" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taught by certified STM instructors (e.g. Liga Małżeństwo Małżeństwu, Instytut Naturalnego Planowania Rodziny, Sensiplan in Germany)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauczana przez certyfikowanych instruktorów STM (np. Liga Małżeństwo Małżeństwu, Instytut Naturalnego Planowania Rodziny, Sensiplan w Niemczech)."
          }
        }
      }
    },
    "education.npr-methods.method.stm.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sympto-Thermal Method"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Symptotermiczna"
          }
        }
      }
    },
    "education.npr-methods.method.stm.rule1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post-ovulatory infertile phase begins on the evening of the 3rd consecutive day of elevated temperature, when all three temperatures are above the coverline and the mucus has dried up"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pofertylna faza niepłodna zaczyna się wieczorem 3. kolejnego dnia podwyższonej temperatury, gdy wszystkie trzy temperatury są powyżej linii pokrycia i śluz wyschnął"
          }
        }
      }
    },
    "education.npr-methods.method.stm.rule2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coverline is drawn 0.05°C above the highest of the last 6 pre-shift temperatures"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia pokrycia jest rysowana 0,05°C powyżej najwyższej z ostatnich 6 temperatur przed skokiem"
          }
        }
      }
    },
    "education.npr-methods.method.stm.rule3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any disturbed temperature is not counted toward the thermal shift confirmation"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna zaburzona temperatura nie liczy się do potwierdzenia skoku termicznego"
          }
        }
      }
    },
    "education.npr-methods.method.stm.rule4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pre-ovulatory phase requires caution — mucus onset marks the beginning of the potentially fertile period"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza przedowulacyjna wymaga ostrożności — pojawienie się śluzu oznacza początek potencjalnie płodnego okresu"
          }
        }
      }
    },
    "education.npr-methods.method.stm.sign1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal body temperature (BBT) — measured each morning before rising"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa temperatura ciała (PTC) — mierzona każdego ranka przed wstaniem"
          }
        }
      }
    },
    "education.npr-methods.method.stm.sign2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical mucus — sensation and appearance observed throughout the day"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy — odczucie i wygląd obserwowane przez cały dzień"
          }
        }
      }
    },
    "education.npr-methods.method.stm.sign3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervix position, firmness, and opening (optional but recommended)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycja, twardość i ujście szyjki (opcjonalne, ale zalecane)"
          }
        }
      }
    },
    "education.npr-methods.method.stm.signs-badge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temp + Mucus + Cervix"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temp + Śluz + Szyjka"
          }
        }
      }
    },
    "education.npr-methods.method.stm.suitable-for" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Women with regular or irregular cycles, women after stopping hormonal contraception, breastfeeding (with adaptations), perimenopause. Best for couples who can measure daily and are willing to learn the rules."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kobiety z regularnymi lub nieregularnymi cyklami, po odstawieniu antykoncepcji hormonalnej, karmiące (z adaptacjami), w perimenopauzie. Najlepsza dla par, które mogą mierzyć codziennie i chcą nauczyć się reguł."
          }
        }
      }
    },
    "education.npr-methods.method.stm.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combines temperature, mucus, and optional cervix signs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łączy temperaturę, śluz i opcjonalnie obserwację szyjki."
          }
        }
      }
    },
