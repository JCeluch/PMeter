    "education.glossary.entry.anovulatory-cycle.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An anovulatory cycle is one in which no egg is released. The uterine lining still builds up under estrogen influence and eventually sheds (withdrawal bleeding), but no thermal shift appears on the BBT chart. Common causes include stress, illness, significant weight changes, intense exercise, breastfeeding, and perimenopause. Occasional anovulatory cycles are normal; frequent ones may require medical evaluation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl bezowulacyjny to taki, w którym nie dochodzi do uwolnienia komórki jajowej. Endometrium nadal narasta pod wpływem estrogenu i ulega złuszczeniu (krwawienie z odstawienia), ale na wykresie PTC nie pojawia się skok termiczny. Częste przyczyny to stres, choroba, znaczne zmiany masy ciała, intensywny wysiłek, karmienie piersią i perimenopauza. Sporadyczne cykle bezowulacyjne są normalne; częste wymagają konsultacji lekarskiej."
          }
        }
      }
    },
    "education.glossary.entry.anovulatory-cycle.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cycle in which ovulation does not occur, showing a flat BBT chart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl, w którym nie dochodzi do owulacji – wykres PTC jest jednofazowy."
          }
        }
      }
    },
    "education.glossary.entry.anovulatory-cycle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anovulatory cycle"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl bezowulacyjny"
          }
        }
      }
    },
    "education.glossary.entry.bbt.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal body temperature is the body's lowest temperature during rest. Measured every morning before getting up, it rises by about 0.2–0.5°C after ovulation due to progesterone and remains elevated until the next period."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa temperatura ciała (PTC) to najniższa temperatura spoczynkowa organizmu. Mierzona codziennie rano przed wstaniem z łóżka, wzrasta o ok. 0,2–0,5°C po owulacji pod wpływem progesteronu i pozostaje podwyższona do kolejnego krwawienia."
          }
        }
      }
    },
    "education.glossary.entry.bbt.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting temperature measured after waking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura spoczynkowa mierzona po przebudzeniu."
          }
        }
      }
    },
    "education.glossary.entry.bbt.tip.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measure immediately after waking, before getting up, speaking or drinking"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierz natychmiast po przebudzeniu, zanim wstaniesz, zanim zaczniesz mówić lub pić."
          }
        }
      }
    },
    "education.glossary.entry.bbt.tip.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the same thermometer each time and the same measurement site (oral, vaginal or rectal)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj zawsze tego samego termometru i tego samego miejsca pomiaru (usta, pochwa lub odbytnica)."
          }
        }
      }
    },
    "education.glossary.entry.bbt.tip.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you had less than 3 hours of uninterrupted sleep, or drank alcohol the night before, mark the temperature as disturbed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli miałaś mniej niż 3 godziny nieprzerwanego snu lub piłaś alkohol poprzedniego wieczoru, oznacz pomiar jako zakłócony."
          }
        }
      }
    },
    "education.glossary.entry.bbt.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal Body Temperature (BBT)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa temperatura ciała (PTC)"
          }
        }
      }
    },
    "education.glossary.entry.billings.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Billings Ovulation Method (BOM) was developed by Drs. John and Evelyn Billings. It is based solely on observing the sensation at the vulva and the appearance of cervical mucus throughout the day. The woman identifies a \"peak day\" — the last day of slippery or stretchy mucus — after which a defined number of infertile days are counted. No thermometer is required."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Billingsów (BOM) opracowana przez dr. Johna i Evelyn Billings opiera się wyłącznie na obserwacji odczucia przy wejściu do pochwy i wyglądu śluzu szyjkowego przez cały dzień. Kobieta identyfikuje „dzień szczytowy\" — ostatni dzień śluzu o charakterze ślisko-rozciągliwym — po którym odlicza określoną liczbę niepłodnych dni. Nie wymaga termometru."
          }
        }
      }
    },
    "education.glossary.entry.billings.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mucus-only FAM method based on observing the sensation and appearance of cervical secretions."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda NPR oparta wyłącznie na obserwacji odczucia i wyglądu wydzieliny szyjkowej."
          }
        }
      }
    },
    "education.glossary.entry.billings.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billings Ovulation Method"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda Billingsów"
          }
        }
      }
    },
    "education.glossary.entry.biphasic-cycle.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biphasic cycle is characterised by a clear, sustained rise in BBT that divides the cycle into a low-temperature pre-ovulatory phase and a high-temperature post-ovulatory phase. A biphasic pattern on the chart confirms ovulation occurred. Monophasic charts (no rise) may suggest anovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl dwufazowy charakteryzuje się wyraźnym, trwałym wzrostem PTC dzielącym cykl na niską fazę przedowulacyjną i wyższą fazę pookoulacyjną. Wzorzec dwufazowy na wykresie potwierdza zajście owulacji. Wykresy jednofazowe (bez wzrostu) mogą sugerować brak owulacji."
          }
        }
      }
    },
    "education.glossary.entry.biphasic-cycle.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cycle with two distinct temperature phases separated by ovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl z dwoma wyraźnymi fazami temperatury rozdzielonymi owulacją."
          }
        }
      }
    },
    "education.glossary.entry.biphasic-cycle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biphasic Cycle"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl dwufazowy"
          }
        }
      }
    },
    "education.glossary.entry.breastfeeding.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During breastfeeding, prolactin suppresses the release of FSH and LH from the pituitary, inhibiting ovulation. This natural postpartum infertility (LAM) can be used as contraception under specific conditions (exclusive breastfeeding, amenorrhoea, baby under 6 months). As nursing frequency decreases, cycles gradually return — often irregular and anovulatory at first. Charting during this period requires patience."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas karmienia piersią prolaktyna hamuje wydzielanie FSH i LH przez przysadkę, blokując owulację. Ta naturalna niepłodność poporodowa (LAM) może być stosowana jako antykoncepcja przy spełnieniu określonych warunków (wyłączne karmienie, brak miesiączki, dziecko poniżej 6 miesiąca). Gdy częstotliwość karmień maleje, cykle stopniowo powracają — często nieregularne i bezowulacyjne. Prowadzenie karty w tym okresie wymaga cierpliwości."
          }
        }
      }
    },
    "education.glossary.entry.breastfeeding.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breastfeeding suppresses ovulation due to elevated prolactin, often causing anovulatory cycles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmienie piersią hamuje owulację przez podwyższony prolaktynę, często powodując cykle bezowulacyjne."
          }
        }
      }
    },
    "education.glossary.entry.breastfeeding.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breastfeeding and the cycle"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karmienie piersią a cykl"
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical mucus changes in texture, colour and quantity throughout the cycle under the influence of oestrogen and progesterone. Near ovulation it becomes clear, slippery and stretchy – the most fertile type. After ovulation progesterone makes it thick and tacky, creating a natural barrier to sperm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy zmienia konsystencję, barwę i ilość przez cały cykl pod wpływem estrogenów i progesteronu. Przed owulacją staje się przezroczysty, śliski i rozciągliwy – to typ najbardziej płodny. Po owulacji progesteron sprawia, że jest gęsty i kleisty, tworząc naturalną barierę dla plemników."
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaginal discharge produced by the cervix throughout the cycle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydzielina pochwowa produkowana przez szyjkę macicy przez cały cykl."
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.tip.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check mucus at every bathroom visit – observe the sensation at the vaginal opening before wiping."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzaj śluz przy każdej wizycie w toalecie – obserwuj odczucie przy wejściu do pochwy przed wytarciem."
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.tip.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most fertile sign is the slippery, lubricative sensation, even without visible mucus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbardziej płodnym sygnałem jest śliskie, nawilżające odczucie, nawet bez widocznego śluzu."
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.tip.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not check mucus after intercourse – semen can disguise its appearance."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie sprawdzaj śluzu po stosunku – nasienie może maskować jego wygląd."
          }
        }
      }
    },
    "education.glossary.entry.cervical-mucus.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervical Mucus"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluz szyjkowy"
          }
        }
      }
    },
    "education.glossary.entry.cervix.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cervix is the lower, narrow part of the uterus. Around ovulation it rises, softens and opens slightly (the SHOW signs: Soft, High, Open, Wet). After ovulation it descends, firms up and closes. Observing these changes is an additional fertility sign."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szyjka macicy to dolna, wąska część macicy. Przed owulacją unosi się, mięknie i lekko otwiera (znaki SHOW: Soft, High, Open, Wet). Po owulacji opada, twardnieje i zamyka się. Obserwowanie tych zmian to dodatkowy wskaźnik płodności."
          }
        }
      }
    },
    "education.glossary.entry.cervix.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower part of the uterus whose position and texture change with the cycle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolna część macicy, której pozycja i konsystencja zmieniają się w cyklu."
          }
        }
      }
    },
    "education.glossary.entry.cervix.tip.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check once a day at the same time, ideally in the evening, with clean hands, in the same position each time."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzaj raz dziennie o tej samej porze, najlepiej wieczorem, czystymi rękami, zawsze w tej samej pozycji."
          }
        }
      }
    },
    "education.glossary.entry.cervix.tip.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not check during or just after menstruation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie sprawdzaj podczas miesiączki ani bezpośrednio po niej."
          }
        }
      }
    },
    "education.glossary.entry.cervix.tip.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn your own baseline – cervical position varies between individuals. What matters are changes within your own cycle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naucz się swojego punktu odniesienia – pozycja szyjki różni się między osobami. Ważne są zmiany w Twoim własnym cyklu."
          }
        }
      }
    },
    "education.glossary.entry.cervix.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cervix"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szyjka macicy"
          }
        }
      }
    },
    "education.glossary.entry.corpus-luteum.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After ovulation, the follicle transforms into the corpus luteum — a temporary endocrine gland that produces progesterone and some estrogen. Progesterone causes the BBT rise, thickens cervical mucus, and prepares the uterine lining for implantation. If fertilization does not occur, the corpus luteum degrades after about 12–16 days, progesterone drops, and menstruation begins."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po owulacji pęcherzyk przekształca się w ciałko żółte — tymczasowy gruczoł dokrewny produkujący progesteron i nieco estrogenu. Progesteron powoduje wzrost PTC, zagęszcza śluz szyjkowy i przygotowuje endometrium do implantacji. Jeśli zapłodnienie nie nastąpi, ciałko żółte zanika po ok. 12–16 dniach, progesteron spada i rozpoczyna się miesiączka."
          }
        }
      }
    },
    "education.glossary.entry.corpus-luteum.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporary gland formed after ovulation, producing progesterone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tymczasowy gruczoł powstały po owulacji, produkujący progesteron."
          }
        }
      }
    },
    "education.glossary.entry.corpus-luteum.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corpus luteum"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciałko żółte"
          }
        }
      }
    },
    "education.glossary.entry.coverline.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coverline is drawn 0.05°C above the highest of the last 6 pre-ovulatory temperatures (excluding any disturbances). When 3 consecutive temperatures rise above the coverline, a thermal shift is confirmed and the post-ovulatory infertile phase begins. The coverline is a key interpretation tool in the sympto-thermal method."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linię pokrycia wyznacza się 0,05°C powyżej najwyższej spośród ostatnich 6 temperatur przed owulacją (z pominięciem zaburzeń). Gdy 3 kolejne temperatury przekraczają linię pokrycia, skok termiczny jest potwierdzony i rozpoczyna się poowulacyjna faza niepłodna. Linia pokrycia jest kluczowym narzędziem interpretacyjnym w metodzie symptotermicznej."
          }
        }
      }
    },
    "education.glossary.entry.coverline.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A horizontal line on the BBT chart drawn above the pre-ovulatory temperatures to confirm thermal shift."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozioma linia na wykresie PTC wyznaczana powyżej temperatur przed owulacją, potwierdzająca skok termiczny."
          }
        }
      }
    },
    "education.glossary.entry.coverline.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coverline"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia pokrycia"
          }
        }
      }
    },
    "education.glossary.entry.creighton.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Creighton Model FertilityCare System (CrMS) uses a precise code system to record the color, consistency, and sensation of cervical secretions. CrMS forms the basis of NaProTechnology — a medical approach to diagnosing and treating reproductive health conditions (e.g., PCOS, endometriosis, recurrent miscarriage) using charted data."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model Creightona (CrMS) używa precyzyjnego systemu kodów do zapisu koloru, konsystencji i odczucia wydzieliny szyjkowej. CrMS stanowi podstawę NaProTechnology — medycznego podejścia do diagnozowania i leczenia problemów rozrodczych (PCOS, endometrioza, nawykowe poronienia) z użyciem danych z kart."
          }
        }
      }
    },
    "education.glossary.entry.creighton.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A standardized mucus-based FAM method using a detailed observation code system."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustandaryzowana metoda NPR oparta na obserwacji śluzu z szczegółowym systemem kodów."
          }
        }
      }
    },
    "education.glossary.entry.creighton.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creighton Model"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model Creightona (CrMS)"
          }
        }
      }
    },
    "education.glossary.entry.estrogen.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrogen (primarily estradiol) is produced by growing ovarian follicles during the follicular phase. It is responsible for the development of egg-white cervical mucus, the proliferation of the uterine lining, and — when it reaches peak levels — triggers the LH surge that causes ovulation. In FAM, rising estrogen is reflected in mucus becoming increasingly wet and stretchy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrogen (głównie estradiol) jest produkowany przez rosnące pęcherzyki jajnikowe w fazie folikularnej. Odpowiada za powstawanie śluzu jak białko jajka, rozrost endometrium oraz — gdy osiąga szczyt — wyzwala skok LH wywołujący owulację. W metodach NPR rosnący estrogen objawia się coraz bardziej wilgotnym i rozciągliwym śluzem."
          }
        }
      }
    },
    "education.glossary.entry.estrogen.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormone produced by follicles, responsible for fertile-type mucus and the LH surge."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormon produkowany przez pęcherzyki, odpowiedzialny za śluz płodny i skok LH."
          }
        }
      }
    },
    "education.glossary.entry.estrogen.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrogen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrogen"
          }
        }
      }
    },
    "education.glossary.entry.fertile-window.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fertile window spans the days when pregnancy can result from unprotected intercourse. It includes the 5 days before ovulation (sperm survival) and the day of ovulation itself (egg survival 12–24 h). In practice it is identified by observing fertile-type mucus, LH surge and temperature shift."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno płodności obejmuje dni, w których niezabezpieczony stosunek może skutkować ciążą. Obejmuje 5 dni przed owulacją (przeżycie plemników) i sam dzień owulacji (przeżycie komórki jajowej 12–24 h). W praktyce identyfikuje się je przez obserwację płodnego śluzu, wyrzutu LH i skoku termicznego."
          }
        }
      }
    },
    "education.glossary.entry.fertile-window.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The days in the cycle when pregnancy is possible."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni w cyklu, w których ciąża jest możliwa."
          }
        }
      }
    },
    "education.glossary.entry.fertile-window.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertile Window"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno płodności"
          }
        }
      }
    },
    "education.glossary.entry.follicular-phase.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The follicular phase begins on the first day of menstruation and ends with ovulation. Under the influence of FSH, follicles in the ovary develop, and the dominant follicle produces increasing amounts of estrogen. Estrogen causes the uterine lining to thicken and triggers the LH surge that leads to ovulation. The length of this phase varies between cycles and determines the total cycle length."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza folikularna rozpoczyna się pierwszego dnia miesiączki i kończy owulacją. Pod wpływem FSH rozwijają się pęcherzyki w jajniku, a dominujący produkuje rosnące ilości estrogenu. Estrogen powoduje rozrost błony śluzowej macicy i wyzwala skok LH prowadzący do owulacji. Długość tej fazy zmienia się między cyklami i determinuje całkowitą długość cyklu."
          }
        }
      }
    },
    "education.glossary.entry.follicular-phase.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First phase of the cycle, from menstruation to ovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsza faza cyklu, od menstruacji do owulacji."
          }
        }
      }
    },
    "education.glossary.entry.follicular-phase.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follicular phase"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza folikularna"
          }
        }
      }
    },
    "education.glossary.entry.fsh.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FSH is secreted by the pituitary gland at the beginning of the cycle. It stimulates the growth and maturation of ovarian follicles. As estrogen levels rise, FSH is suppressed (negative feedback), leaving only the dominant follicle to continue growing. Elevated FSH levels can indicate diminished ovarian reserve and are often monitored in fertility diagnostics."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FSH jest wydzielany przez przysadkę mózgową na początku cyklu. Stymuluje wzrost i dojrzewanie pęcherzyków jajnikowych. W miarę wzrostu estrogenu FSH jest hamowany (ujemne sprzężenie zwrotne), co pozwala tylko dominującemu pęcherzykowi kontynuować wzrost. Podwyższone FSH może świadczyć o obniżonej rezerwie jajnikowej i jest często monitorowane w diagnostyce płodności."
          }
        }
      }
    },
    "education.glossary.entry.fsh.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pituitary hormone that stimulates follicle growth at the start of the cycle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormon przysadki stymulujący wzrost pęcherzyków na początku cyklu."
          }
        }
      }
    },
    "education.glossary.entry.fsh.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FSH (Follicle-Stimulating Hormone)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FSH (hormon folikulotropowy)"
          }
        }
      }
    },
    "education.glossary.entry.implantation.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implantation occurs when a fertilized egg (blastocyst) attaches to and embeds in the uterine lining, typically 6–10 days after ovulation. This triggers hCG production, which maintains the corpus luteum and prolongs progesterone secretion. On the BBT chart, successful implantation may be visible as an implantation dip — a brief temperature drop in the luteal phase — though this sign is not reliable enough for interpretation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implantacja następuje, gdy zapłodnione jajo (blastocysta) przyczepia się do endometrium i zagnieżdża, zazwyczaj 6–10 dni po owulacji. Wyzwala to produkcję hCG, która podtrzymuje ciałko żółte i przedłuża wydzielanie progesteronu. Na wykresie PTC udana implantacja może być widoczna jako „implantation dip\" — krótkotrwały spadek temperatury w fazie lutealnej — choć ten znak nie jest wystarczająco wiarygodny do interpretacji."
          }
        }
      }
    },
    "education.glossary.entry.implantation.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embedding of a fertilized egg in the uterine lining, occurring 6–10 days after ovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zagnieżdżenie zapłodnionej komórki jajowej w endometrium, następujące 6–10 dni po owulacji."
          }
        }
      }
    },
    "education.glossary.entry.implantation.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implantation"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implantacja"
          }
        }
      }
    },
    "education.glossary.entry.lh.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The LH (luteinising hormone) surge is a sharp rise in hormone level that triggers the release of an egg from the follicle. An LH test detects this surge in urine. A positive result indicates that ovulation is likely within 12–36 hours."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrzut LH (hormonu luteinizującego) to gwałtowny wzrost poziomu hormonu, który wyzwala uwolnienie komórki jajowej z pęcherzyka. Test LH wykrywa ten wyrzut w moczu. Wynik pozytywny oznacza, że owulacja nastąpi prawdopodobnie w ciągu 12–36 godzin."
          }
        }
      }
    },
    "education.glossary.entry.lh.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormone surge that triggers ovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrzut hormonu wyzwalającego owulację."
          }
        }
      }
    },
    "education.glossary.entry.lh.tip.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test between 10:00 and 20:00 – avoid the first morning urine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testuj między 10:00 a 20:00 – unikaj pierwszego porannego moczu."
          }
        }
      }
    },
    "education.glossary.entry.lh.tip.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A positive result means the test line is as dark as or darker than the control line."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynik pozytywny oznacza, że linia testowa jest tak ciemna jak linia kontrolna lub ciemniejsza."
          }
        }
      }
    },
    "education.glossary.entry.lh.tip.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak means the darkest result you have seen this cycle – the real LH peak before it drops."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak oznacza najciemniejszy wynik, jaki widziałaś w tym cyklu – prawdziwy szczyt LH tuż przed jego spadkiem."
          }
        }
      }
    },
    "education.glossary.entry.lh.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LH Surge (LH Test)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrzut LH (Test LH)"
          }
        }
      }
    },
    "education.glossary.entry.luteal-phase.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The luteal phase begins after ovulation and ends with the first day of the next period. It is driven by progesterone secreted by the corpus luteum. Its length is relatively constant for each person (usually 10–16 days) and is identified on the chart by the sustained high-temperature phase."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza lutealna rozpoczyna się po owulacji i kończy pierwszym dniem kolejnego krwawienia. Steruje nią progesteron wydzielany przez ciałko żółte. Jej długość jest stosunkowo stała dla każdej osoby (zwykle 10–16 dni) i identyfikowana jest na wykresie przez trwałą wysoką fazę temperaturową."
          }
        }
      }
    },
    "education.glossary.entry.luteal-phase.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The second half of the cycle after ovulation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druga połowa cyklu po owulacji."
          }
        }
      }
    },
    "education.glossary.entry.luteal-phase.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luteal Phase"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faza lutealna"
          }
        }
      }
    },
    "education.glossary.entry.menstrual-cycle.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The menstrual cycle is a monthly hormonal process divided into four phases: menstrual (bleeding), follicular (egg maturation), ovulatory (egg release), and luteal (post-ovulation). Its length is counted from the first day of one period to the day before the next. Average length is 28 days, but 21–35 days is considered normal. Cycle length and symptoms vary between individuals and can change with age, stress, or health."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl miesiączkowy to comiesięczny proces hormonalny podzielony na cztery fazy: menstruacyjną (krwawienie), folikularną (dojrzewanie pęcherzyka), owulacyjną (uwolnienie komórki jajowej) i lutealną (po owulacji). Jego długość liczona jest od pierwszego dnia krwawienia do dnia poprzedzającego kolejne. Średnia długość wynosi 28 dni, ale norma to 21–35 dni. Długość cyklu i objawy mogą się różnić między osobami i zmieniać z wiekiem, stresem lub stanem zdrowia."
          }
        }
      }
    },
    "education.glossary.entry.menstrual-cycle.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recurring hormonal cycle that prepares the body for potential pregnancy, typically lasting 21–35 days."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powtarzający się cykl hormonalny przygotowujący organizm do ewentualnej ciąży, trwający zazwyczaj 21–35 dni."
          }
        }
      }
    },
    "education.glossary.entry.menstrual-cycle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menstrual Cycle"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cykl miesiączkowy"
          }
        }
      }
    },
    "education.glossary.entry.ovulation.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovulation is the moment when a mature egg is released from the dominant follicle, typically 24–36 hours after the LH peak. The egg can be fertilized for approximately 12–24 hours. Ovulation marks the boundary between the follicular and luteal phases. Signs include egg-white cervical mucus, slippery sensation, a positive LH test, and a BBT rise the following day."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owulacja to moment uwolnienia dojrzałej komórki jajowej z dominującego pęcherzyka, zazwyczaj 24–36 godzin po szczycie LH. Komórka jajowa może zostać zapłodniona przez około 12–24 godziny. Owulacja wyznacza granicę między fazą folikularną a lutealną. Sygnały to śluz jak białko jajka, uczucie śliskości, pozytywny test LH oraz wzrost PTC następnego dnia."
          }
        }
      }
    },
    "education.glossary.entry.ovulation.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release of a mature egg from the ovary, triggered by the LH surge."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwolnienie dojrzałej komórki jajowej z jajnika, wywołane skokiem LH."
          }
        }
      }
    },
    "education.glossary.entry.ovulation.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovulation"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Owulacja"
          }
        }
      }
    },
    "education.glossary.entry.peak-day.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak Day is the last day you observe the most fertile-type cervical mucus – clear, slippery and stretchy like egg white. It is identified retrospectively, the day after the mucus changes. Ovulation typically occurs within ±2 days of Peak Day."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień Szczytowy to ostatni dzień, w którym obserwujesz śluz szyjkowy najbardziej płodnego typu – przezroczysty, śliski i rozciągliwy jak białko jajka. Rozpoznaje się go retrospektywnie, dzień po zmianie śluzu. Owulacja następuje zwykle w ciągu ±2 dni od Dnia Szczytowego."
          }
        }
      }
    },
    "education.glossary.entry.peak-day.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last day of the most fertile mucus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatni dzień najbardziej płodnego śluzu."
          }
        }
      }
    },
    "education.glossary.entry.peak-day.tip.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark Peak Day on the day after the slippery, stretchy feeling disappears – not the day you notice it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz Dzień Szczytowy dzień po zniknięciu śliskiego, rozciągliwego odczucia – nie w dniu, gdy je zauważysz."
          }
        }
      }
    },
    "education.glossary.entry.peak-day.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak Day"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień Szczytowy"
          }
        }
      }
    },
    "education.glossary.entry.pms.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PMS refers to a cluster of physical and psychological symptoms appearing 1–2 weeks before menstruation and resolving with its onset. Common symptoms include mood swings, irritability, bloating, breast tenderness, fatigue, and food cravings. Tracking symptoms in the chart can help identify patterns and predict onset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PMS to zespół objawów fizycznych i psychicznych pojawiających się 1–2 tygodnie przed miesiączką i ustępujących wraz z jej początkiem. Typowe objawy to wahania nastroju, drażliwość, wzdęcia, tkliwość piersi, zmęczenie i zachcianki pokarmowe. Śledzenie objawów w karcie pomaga identyfikować wzorce i przewidywać wystąpienie PMS."
          }
        }
      }
    },
    "education.glossary.entry.pms.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physical and emotional symptoms appearing in the luteal phase before menstruation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objawy fizyczne i emocjonalne pojawiające się w fazie lutealnej przed miesiączką."
          }
        }
      }
    },
    "education.glossary.entry.pms.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PMS (Premenstrual Syndrome)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PMS (zespół napięcia przedmiesiączkowego)"
          }
        }
      }
    },
    "education.glossary.entry.progesterone.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progesterone is produced by the corpus luteum after ovulation. It causes the characteristic BBT rise (thermal shift) visible on the chart, thickens cervical mucus (blocking further sperm), and prepares the uterine lining for a fertilized egg. Progesterone maintains the luteal phase at a relatively constant length of 12–16 days. Its drop at the end of the cycle triggers menstruation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progesteron jest produkowany przez ciałko żółte po owulacji. Powoduje charakterystyczny wzrost PTC (skok termiczny) widoczny na wykresie, zagęszcza śluz szyjkowy (blokując dalsze plemniki) i przygotowuje endometrium na zapłodnione jajo. Progesteron utrzymuje fazę lutealną o względnie stałej długości 12–16 dni. Jego spadek pod koniec cyklu wywołuje miesiączkę."
          }
        }
      }
    },
    "education.glossary.entry.progesterone.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormone of the luteal phase, causing the BBT rise and drying of mucus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hormon fazy lutealnej, powodujący wzrost PTC i wysychanie śluzu."
          }
        }
      }
    },
    "education.glossary.entry.progesterone.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progesterone"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progesteron"
          }
        }
      }
    },
    "education.glossary.entry.show.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHOW is a mnemonic for the four fertile signs of the cervix: Soft (the cervix feels like lips instead of a nose tip), High (it is hard to reach), Open (the os is slightly open), Wet (fertile mucus is present). All four signs together indicate peak fertility."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHOW to mnemonic oznaczający cztery płodne cechy szyjki macicy: Soft (miękka jak wargi), High (trudno dosięgnąć), Open (ujście lekko otwarte), Wet (obecny płodny śluz). Wszystkie cztery cechy jednocześnie wskazują na szczyt płodności."
          }
        }
      }
    },
    "education.glossary.entry.show.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acronym for fertile cervix signs: Soft, High, Open, Wet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akronim płodnych cech szyjki: Soft (miękka), High (wysoka), Open (otwarta), Wet (mokra)."
          }
        }
      }
    },
    "education.glossary.entry.show.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHOW"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHOW"
          }
        }
      }
    },
    "education.glossary.entry.spotting.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotting is light bleeding that does not meet the criteria for full menstrual flow. It may occur around ovulation (mid-cycle spotting), in the early luteal phase (implantation spotting), at the start or end of menstruation, or due to cervical irritation. In FAM charting, spotting is recorded separately and does not mark the start of a new cycle. Frequent or unusual spotting should be evaluated by a doctor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plamienie to lekkie krwawienie niespełniające kryteriów pełnego przepływu miesiączkowego. Może pojawić się wokół owulacji (plamienie środkowe), na początku fazy lutealnej (plamienie implantacyjne), na początku lub końcu miesiączki albo w wyniku podrażnienia szyjki. W karcie NPR plamienie jest notowane oddzielnie i nie wyznacza początku nowego cyklu. Częste lub nietypowe plamienie powinno być zbadane przez lekarza."
          }
        }
      }
    },
    "education.glossary.entry.spotting.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light, irregular bleeding outside of menstruation, not counted as a cycle start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekkie, nieregularne krwawienie poza miesiączką, niezaliczane jako początek cyklu."
          }
        }
      }
    },
    "education.glossary.entry.spotting.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotting"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plamienie"
          }
        }
      }
    },
    "education.glossary.entry.sympto-thermal.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sympto-thermal method (STM) combines daily BBT charting with cervical mucus observation, and optionally cervix monitoring. Ovulation is confirmed by a double check: thermal shift (3 temps above coverline) AND peak mucus day. With correct and consistent use, STM has a method effectiveness comparable to hormonal contraception (99%+). It is used both to avoid and to achieve pregnancy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda symptotermalna (STM) łączy codzienne mierzenie PTC z obserwacją śluzu szyjkowego, opcjonalnie też szyjki macicy. Owulacja jest potwierdzana podwójnym sprawdzeniem: skok termiczny (3 temp. powyżej linii pokrycia) ORAZ szczytowy dzień śluzu. Przy prawidłowym stosowaniu skuteczność STM jest porównywalna z antykoncepcją hormonalną (99%+). Stosuje się ją zarówno do unikania, jak i osiągania ciąży."
          }
        }
      }
    },
    "education.glossary.entry.sympto-thermal.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FAM method combining BBT and cervical mucus observation to identify fertile and infertile days."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda NPR łącząca obserwację PTC i śluzu szyjkowego w celu identyfikacji dni płodnych i niepłodnych."
          }
        }
      }
    },
    "education.glossary.entry.sympto-thermal.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sympto-thermal method"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metoda symptotermalna (STM)"
          }
        }
      }
    },
    "education.glossary.entry.thermal-shift.definition" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The thermal shift is a sustained rise in basal body temperature of at least 0.2°C above the six previous temperatures, maintained for at least three days. It confirms that ovulation has occurred and marks the start of the infertile post-ovulatory phase."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skok termiczny to trwały wzrost podstawowej temperatury ciała o co najmniej 0,2°C powyżej sześciu poprzednich temperatur, utrzymujący się przez co najmniej trzy dni. Potwierdza zajście owulacji i wyznacza początek niepłodnej fazy pooowulacyjnej."
          }
        }
      }
    },
    "education.glossary.entry.thermal-shift.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rise in BBT after ovulation caused by progesterone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzrost PTC po owulacji spowodowany progesteronem."
          }
        }
      }
    },
    "education.glossary.entry.thermal-shift.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thermal Shift"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skok termiczny"
          }
        }
      }
    },
    "education.glossary.search.placeholder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search terms…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj pojęć…"
          }
        }
      }
